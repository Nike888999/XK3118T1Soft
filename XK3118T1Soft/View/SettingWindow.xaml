<Window x:Class="XK3118T1Soft.View.SettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:XK3118T1Soft.View"
        mc:Ignorable="d"
        Title="⚙️ Настройки COM-порта" 
        Height="500" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="#1A1A2E"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Стиль для заголовков групп -->
        <Style TargetType="Label" x:Key="GroupHeaderStyle">
            <Setter Property="Foreground" Value="#4FC3F7"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Стиль для подписей параметров -->
        <Style TargetType="Label" x:Key="ParamLabelStyle">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Width" Value="100"/>
        </Style>

        <!-- Стиль для ComboBox -->
        <Style TargetType="ComboBox" x:Key="SettingsComboBoxStyle">
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#16213E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#0F3460"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Стиль для кнопок -->
        <Style TargetType="Button" x:Key="DialogButtonStyle">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                BorderBrush="#0F3460" 
                                BorderThickness="2">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для разделителя -->
        <Style TargetType="Separator">
            <Setter Property="Height" Value="2"/>
            <Setter Property="Background" Value="#0F3460"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" 
                Background="#16213E" 
                CornerRadius="12" 
                Padding="20,15" 
                Margin="0,0,0,20">
            <StackPanel>
                <Label Content="⚙️ НАСТРОЙКИ COM-ПОРТА" 
                       Foreground="White" 
                       FontSize="22" 
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
                <Label Content="Настройте параметры последовательного порта для связи с весовым терминалом" 
                       Foreground="#8888AA" 
                       FontSize="13"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Основная область с настройками -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      Margin="0,0,0,20">
            <StackPanel>
                <!-- Группа: Основные настройки -->
                <Border Background="#16213E" 
                        CornerRadius="12" 
                        Padding="20" 
                        Margin="0,0,0,15">
                    <StackPanel>
                        <Label Content="🔌 Основные параметры" 
                               Style="{StaticResource GroupHeaderStyle}"/>

                        <Separator/>

                        <!-- COM-порт -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="COM-порт:" Style="{StaticResource ParamLabelStyle}"/>
                            <ComboBox x:Name="cmbPorts" 
                                      Grid.Column="1"
                                      Foreground="Black"
                                      Style="{StaticResource SettingsComboBoxStyle}"
                                      Width="200"
                                      SelectedItem="{Binding Port}"
                                      HorizontalAlignment="Left">
                                <ComboBoxItem Content="COM1"/>
                                <ComboBoxItem Content="COM2"/>
                                <ComboBoxItem Content="COM3"/>
                                <ComboBoxItem Content="COM4"/>
                                <ComboBoxItem Content="COM5"/>
                                <ComboBoxItem Content="COM6"/>
                                <ComboBoxItem Content="COM7"/>
                                <ComboBoxItem Content="COM8"/>
                                <ComboBoxItem Content="COM9"/>
                            </ComboBox>
                        </Grid>

                        <!-- Скорость -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Скорость (бод):" Style="{StaticResource ParamLabelStyle}"/>
                            <ComboBox x:Name="cmbBaudRate" 
                                      Grid.Column="1"
                                      Foreground="Black"
                                      Style="{StaticResource SettingsComboBoxStyle}"
                                      SelectedItem="{Binding SettingBoudRate}"
                                      HorizontalAlignment="Left">
                                <ComboBoxItem Content="1200"/>
                                <ComboBoxItem Content="2400"/>
                                <ComboBoxItem Content="4800"/>
                                <ComboBoxItem Content="9600" IsSelected="True"/>
                                <ComboBoxItem Content="19200"/>
                                <ComboBoxItem Content="38400"/>
                                <ComboBoxItem Content="57600"/>
                                <ComboBoxItem Content="115200"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Группа: Дополнительные настройки -->
                <Border Background="#16213E" 
                        CornerRadius="12" 
                        Padding="20" 
                        Margin="0,0,0,15">
                    <StackPanel>
                        <Label Content="🔧 Дополнительные параметры" 
                               Style="{StaticResource GroupHeaderStyle}"/>

                        <Separator/>

                        <!-- Биты данных -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Биты данных:" Style="{StaticResource ParamLabelStyle}"/>
                            <ComboBox x:Name="cmbDataBits" 
                                      Grid.Column="1"
                                      SelectedItem="{Binding SettingDataBits}"
                                      Foreground="Black"
                                      Style="{StaticResource SettingsComboBoxStyle}"
                                      HorizontalAlignment="Left">
                                <ComboBoxItem Content="7"/>
                                <ComboBoxItem Content="8" IsSelected="True"/>
                            </ComboBox>
                        </Grid>

                        <!-- Стоп-биты -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Стоп-биты:" Style="{StaticResource ParamLabelStyle}"/>
                            <ComboBox x:Name="cmbStopBits" 
                                      Foreground="Black"
                                      Grid.Column="1"
                                      Style="{StaticResource SettingsComboBoxStyle}"
                                      HorizontalAlignment="Left"
                                      SelectedItem="{Binding SettingStopBits}">
                                <ComboBoxItem Content="1" IsSelected="True"/>
                                <ComboBoxItem Content="1.5"/>
                                <ComboBoxItem Content="2"/>
                            </ComboBox>
                        </Grid>

                        <!-- Четность -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Четность:" Style="{StaticResource ParamLabelStyle}"/>
                            <ComboBox x:Name="cmbParity" 
                                      Grid.Column="1"
                                      Foreground="Black"
                                      SelectedItem="{Binding SettingParity}"
                                      Style="{StaticResource SettingsComboBoxStyle}"
                                      HorizontalAlignment="Left">
                                <ComboBoxItem Content="Нет" IsSelected="True"/>
                                <ComboBoxItem Content="Нечет"/>
                                <ComboBoxItem Content="Чет"/>
                                <ComboBoxItem Content="Марк"/>
                                <ComboBoxItem Content="Спейс"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Группа: Информация -->
                <Border Background="#16213E" 
                        CornerRadius="12" 
                        Padding="20">
                    <StackPanel>
                        <Label Content="ℹ️ Информация" 
                               Style="{StaticResource GroupHeaderStyle}"/>

                        <Separator/>

                        <TextBlock Foreground="#8888AA" 
                                   FontSize="13"
                                   TextWrapping="Wrap">
                            <Run Text="Текущие настройки:" FontWeight="Bold" Foreground="#4FC3F7"/>
                            <Run Text=" "/>
                            <Run x:Name="txtPortInfo" 
                                 Text="COM1, 9600 бод, 8 бит данных, 1 стоп-бит, без четности"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки управления -->
        <Border Grid.Row="2" 
                Background="#16213E" 
                CornerRadius="12" 
                Padding="20" 
                Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnTest" 
                        Grid.Column="1"
                        Content="🔍 Тест порта"
                        Style="{StaticResource DialogButtonStyle}"
                        Background="#E65100"
                        Margin="0,0,10,0"
                        Width="130"/>

                <Button x:Name="btnSave" 
                        Grid.Column="2"
                        Content="💾 Сохранить"
                        Style="{StaticResource DialogButtonStyle}"
                        Background="#2E7D32"
                        Margin="0,0,10,0"
                        Click="SaveButton_Click"/>

                <Button x:Name="btnCancel" 
                        Grid.Column="3"
                        Content="❌ Отмена"
                        Style="{StaticResource DialogButtonStyle}"
                        Background="#C62828"/>
            </Grid>
        </Border>
    </Grid>
</Window>
