<Window x:Class="XK3118T1Soft.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:XK3118T1Soft"
        mc:Ignorable="d"
        Title="XK3118T1+ Весовой терминал" 
        Height="550" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A2E">

    <Window.Resources>
        <!-- Стили для кнопок -->
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#16213E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                BorderBrush="#0F3460" 
                                BorderThickness="2">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0F3460"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#533483"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#555555"/>
                                <Setter Property="Foreground" Value="#AAAAAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для кнопки Старт -->
        <Style TargetType="Button" x:Key="StartButtonStyle" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Width" Value="100"/>
        </Style>

        <!-- Стиль для кнопки Стоп -->
        <Style TargetType="Button" x:Key="StopButtonStyle" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#C62828"/>
            <Setter Property="Width" Value="100"/>
        </Style>

        <!-- Стиль для ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#16213E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#0F3460"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- Конвертер для цвета веса -->
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель управления -->
        <Border Grid.Row="0" 
                Background="#16213E" 
                CornerRadius="12" 
                Padding="15" 
                Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnSettingPort" 
                            Grid.Column="0"
                            Content="⚙️ Настройки"
                            Command="{Binding SettingCommand}"
                            Margin="0,0,10,0"/>

                <Button x:Name="btnSavePort" 
                        Grid.Column="1"
                        Content="⚙️ Сохраненный"
                        Command="{Binding SeePort}"
                        Margin="0,0,50,0"/>

               

                <Button x:Name="btnRefresh" 
                            Grid.Column="2"
                            Content="🔄 Обновить"
                            Width="100"
                            Margin="80,0,20,0" 
                            Cursor="Hand"/>

                <Button x:Name="btnStart" 
                            Grid.Column="3"
                            Content="▶ Старт"
                            Style="{StaticResource StartButtonStyle}"
                            Margin="0,0,30,0"
                            Command="{Binding StartCommand}" 
                            Cursor="Hand"/>

                <Button x:Name="btnStop" 
                            Grid.Column="4"
                            Content="⏹ Стоп"
                            Style="{StaticResource StopButtonStyle}"
                            Command="{Binding StopCommand}"/>
            </Grid>
        </Border>

        <!-- Основной дисплей веса -->
        <Border Grid.Row="1" 
                Background="#16213E" 
                CornerRadius="20" 
                Padding="30"
                Margin="0,0,0,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <Label Grid.Row="0" 
                       Content="⚖️ ТЕКУЩИЙ ВЕС" 
                       Foreground="#8888AA" 
                       FontSize="18" 
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

                <!-- Индикатор веса -->
                <Viewbox Grid.Row="1" 
                         Stretch="Uniform" 
                         Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock x:Name="txtWeight" 
                                   Text="{Binding Weight}" 
                                   Foreground="#4FC3F7"
                                   FontSize="80" 
                                   FontWeight="Bold"
                                   FontFamily="Segoe UI"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Viewbox>

                <!-- Статус и единицы измерения -->
                <StackPanel Grid.Row="2" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Center"
                            Margin="0,10,0,0">
                    <TextBlock x:Name="txtUnit" 
                               Text="кг" 
                               Foreground="#8888AA" 
                               FontSize="24" 
                               FontWeight="SemiBold"
                               Margin="0,0,20,0"/>

                    <Border Background="#0F3460" 
                            CornerRadius="12" 
                            Padding="15,5"
                            Margin="0,0,20,0">
                        <TextBlock x:Name="txtStatus" 
                                   Text="{Binding Status}" 
                                   Foreground="#FFA726" 
                                   FontSize="16" 
                                   FontWeight="Bold"/>
                    </Border>

                    <Border Background="#0F3460" 
                            CornerRadius="12" 
                            Padding="15,5">
                        <TextBlock x:Name="txtMode" 
                                   Text="{Binding Mode}" 
                                   Foreground="#66BB6A" 
                                   FontSize="14" 
                                   FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Нижняя панель с логом -->
        <Border Grid.Row="2" 
                Background="#16213E" 
                CornerRadius="12" 
                Padding="15" 
                Height="120">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Label Content="📋 Лог событий" 
                       Foreground="#8888AA" 
                       FontSize="12" 
                       FontWeight="Bold"
                       Margin="0,0,0,5"/>

                <ScrollViewer Grid.Row="1" 
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ListBox x:Name="lstLog" 
                             Background="Transparent" 
                             Foreground="#CCCCDD"
                             FontSize="12"
                             BorderThickness="0"
                             ItemsSource="{Binding}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" 
                                           Foreground="#CCCCDD"
                                           Margin="0,2"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
